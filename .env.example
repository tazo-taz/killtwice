# Copy to .env to override locally. Every value here also has a default in
# scripts/lib.sh, so the repo runs with no .env at all.

# Dataset size. FAST=1 drops SEED_ROWS to 500000 for a ~3 minute verify run.
FAST=0
SEED_ROWS=5000000

# Where the pipeline and Elasticsearch answer.
PIPELINE_URL=http://localhost:3000
ES_URL=http://localhost:9200

# Restrict a verify run to specific gates, e.g. GATES=g1,g3
GATES=g1,g2,g3,g4,g5
